# Copy to .env and edit:  cp .env.example .env
# Every variable is documented in app/core/config.py.

APP_NAME="FastAPI Starter"
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# ---------- Database ----------
# SQLite: zero setup, good for learning and tests.
DATABASE_URL=sqlite:///./app.db
# Postgres (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# Supabase: Connect -> Session pooler (port 5432); URL-encode special chars in the password (@ -> %40):
# DATABASE_URL=postgresql+psycopg://postgres.YOURREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------- Auth ----------
# REQUIRED, at least 32 characters. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-a-long-random-string-of-64-chars-0000000000000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_EMAIL_VERIFICATION=true

# ---------- Email ----------
# console = codes are printed in the uvicorn terminal (no setup)
# smtp    = real sending (see the SMTP examples below)
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME="FastAPI Starter"

# Mailpit (docker compose up -d mailpit, inbox at http://localhost:8025):
# EMAIL_BACKEND=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_STARTTLS=false

# Gmail (needs 2FA + an App Password: https://myaccount.google.com/apppasswords):
# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# EMAIL_FROM=you@gmail.com
