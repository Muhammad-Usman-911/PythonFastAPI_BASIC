# Supabase: Connect -> Session pooler (port 5432). Add the "+psycopg2" part.
# URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql+psycopg2://postgres.YOURREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Leave SMTP_HOST empty in dev: OTP codes are printed in the uvicorn console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
